# Shared
DATABASE_URL=postgres://user:password@host:5432/db
JWT_ACCESS_SECRET=replace-access-secret
JWT_REFRESH_SECRET=replace-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
IDEMPOTENCY_TTL_HOURS=24

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-service-role-key
SUPABASE_BUCKET_DELIVERY_PROOFS=delivery-proofs
SUPABASE_BUCKET_QC_PROOFS=qc-proofs
SUPABASE_BUCKET_INCIDENT_PROOFS=incident-proofs
SUPABASE_BUCKET_INVOICES=invoices
SUPABASE_BUCKET_EXPORTS=exports
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_UPLOAD_SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=15728640

# Render
RENDER_API_KEY=replace-render-api-key
RENDER_SERVICE_ID=
RENDER_OWNER_ID=
RENDER_REPO_URL=https://github.com/your-org/mbg-ops.git
RENDER_REPO_BRANCH=main
RENDER_SERVICE_NAME=mbg-ops-api

# Vercel
VERCEL_TOKEN=replace-vercel-token
VERCEL_PROJECT_NAME=mbg-ops-web
VERCEL_GIT_REPO=your-org/mbg-ops
VERCEL_GIT_PROVIDER=github
VERCEL_GIT_REF=main
VERCEL_ROOT_DIRECTORY=web
NEXT_PUBLIC_API_BASE_URL=https://your-render-service.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-publishable-key

# Smoke test
SMOKE_API_BASE_URL=https://your-render-service.onrender.com
SMOKE_USER_EMAIL=superadmin@mbg.local
SMOKE_USER_PASSWORD=replace-password
