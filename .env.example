# SPPG Ops SaaS Local Environment
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sppg_ops
NEXTAUTH_SECRET=<ISI_NEXTAUTH_SECRET_MIN_32_CHARS>
NEXTAUTH_URL=http://localhost:3001
APP_URL=http://localhost:3001

MIDTRANS_SERVER_KEY=<ISI_MIDTRANS_SERVER_KEY>
MIDTRANS_CLIENT_KEY=<ISI_MIDTRANS_CLIENT_KEY>
MIDTRANS_MERCHANT_ID=<ISI_MIDTRANS_MERCHANT_ID>
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_WEBHOOK_SIGNATURE_MODE=sha512

SUBSCRIPTION_GRACE_DAYS=7

STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./.uploads
S3_ENDPOINT=<ISI_S3_ENDPOINT>
S3_BUCKET=<ISI_S3_BUCKET>
S3_ACCESS_KEY=<ISI_S3_ACCESS_KEY>
S3_SECRET_KEY=<ISI_S3_SECRET_KEY>
S3_REGION=ap-southeast-1

# Docker Postgres
POSTGRES_DB=sppg_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MinIO (optional)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

